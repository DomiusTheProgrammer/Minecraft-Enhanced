{
    "format_version": "1.20.30",
    "minecraft:item": {
        "description": {
            "identifier": "me:bronze_axe",
            "menu_category": {
                "category": "equipment",
                "group": "itemGroup.name.axe"
            }
        },
        "components": {
            "minecraft:max_stack_size": 1,
            "minecraft:display_name": {
                "value": "item.me:bronze_axe.name"
            },
            "minecraft:icon": "me:bronze_axe",
            "minecraft:damage": 5,
            "minecraft:digger": {
                "use_efficiency": true,
                "destroy_speeds": [
                    {
                        "speed": 6.5,
                        "block": {
                            "tags": "query.any_tag('minecraft:is_tool_item_destructible','minecraft:is_axe_item_destructible')"
                        }
                    }
                ]
            },
            "minecraft:tags": {
                "tags": [
                    "minecraft:axe",
                    "minecraft:is_axe",
                    "minecraft:iron_tier",
                    "minecraft:transformable_items"
                ]
            },
            "minecraft:hand_equipped": true,
            "minecraft:enchantable": {
                "slot": "axe",
                "value": 13
            },
            "minecraft:durability": {
                "max_durability": 600
            },
            "minecraft:repairable": {
                "repair_items": [
                    {
                        "items": [
                            "me:bronze_ingot"
                        ],
                        "repair_amount": 150
                    },
                    {
                        "items": [
                            "me:bronze_axe"
                        ],
                        "repair_amount": "context.other->q.remaining_durability + 0.05 * context.other->q.max_durability"
                    }
                ]
            }
        }
    }
}
