{
    "format_version": "1.21.30",
    "minecraft:item": {
        "description": {
            "identifier": "me:amethyst_axe",
            "menu_category": {
                "category": "equipment",
                "group": "itemGroup.name.axe"
            }
        },
        "components": {
            "minecraft:max_stack_size": 1,
"minecraft:custom_components": ["me:durability"],
            "minecraft:display_name": {
                "value": "item.me:amethyst_axe.name"
            },
            "minecraft:icon": "me:amethyst_axe",
            "minecraft:damage": 5,
            "minecraft:digger": {
                "use_efficiency": true,
                "destroy_speeds": [
                    {
                        "block": {
                            "tags": "query.any_tag('minecraft:is_tool_item_destructible','minecraft:is_axe_item_destructible')"
                        },
                        "speed": 6.0
                    },
                    {
                        "block": {
                            "tags": "query.any_tag('stone', 'wood', 'plant')"
                        },
                        "speed": 6.0
                    }
                ]
            },
            "minecraft:tags": {
                "tags": [
                    "minecraft:axe",
                    "minecraft:is_axe"
                ]
            },
            "minecraft:hand_equipped": true,
            "minecraft:enchantable": {
                "slot": "axe",
                "value": 20
            },
            "minecraft:durability": {
                "damage_chance": {"min": 0, "max": 0},
                "max_durability": 500
            },
            "minecraft:repairable": {
                "repair_items": [
                    {
                        "items": [
                            "minecraft:amethyst_shard"
                        ],
                        "repair_amount": 125
                    },
                    {
                        "items": [
                            "me:amethyst_axe"
                        ],
                        "repair_amount": "context.other->q.remaining_durability + 0.05 * context.other->q.max_durability"
                    }
                ]
            }
        }
    }
}